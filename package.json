{
  "name": "gitlocalize",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub-native, zero-backend i18n collaboration platform.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "app:dev": "vite --config app/vite.config.ts",
    "app:build": "vite build --config app/vite.config.ts",
    "app:sync": "npm run app:build && cap sync android",
    "app:apk": "npm run app:sync && cd android && ./gradlew assembleDebug",
    "editor:build": "vite build --config editor/vite.config.ts",
    "dev": "vuepress dev docs",
    "build": "vuepress build docs",
    "preview": "vuepress build docs && npx serve docs/.vuepress/dist"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "buffer": "^6.0.3",
    "isomorphic-git": "^1.42.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "@vuepress/bundler-vite": "2.0.0-rc.31",
    "@vuepress/theme-default": "2.0.0-rc.134",
    "sass": "^1.104.1",
    "sass-embedded": "^1.104.1",
    "sass-loader": "^17.0.1",
    "vuepress": "2.0.0-rc.31"
  },
  "overrides": {
    "@vuepress/cli": "2.0.0-rc.31",
    "@vuepress/core": "2.0.0-rc.31",
    "@vuepress/utils": "2.0.0-rc.31",
    "@vuepress/shared": "2.0.0-rc.31",
    "@vuepress/markdown": "2.0.0-rc.31",
    "@vuepress/client": "2.0.0-rc.31",
    "@vuepress/bundler-vite": "2.0.0-rc.31"
  }
}
